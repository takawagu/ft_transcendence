// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int             @id @default(autoincrement())
  email               String          @unique
  password            String
  username            String          @unique
  profileImage        String?
  bio                 String?

  gameRecord          ItoGameRecord?
  sentMessages        DirectMessage[] @relation("SentMessages")
  receivedMessages    DirectMessage[] @relation("ReceivedMessages")
  appliedFriendships  Friendship[]    @relation("Applicant")
  receivedFriendships Friendship[]    @relation("Approver")
  blocksMade          Block[]         @relation("Blocker")
  blocksReceived      Block[]         @relation("Blocked")
}

model ItoGameRecord {
  id           Int  @id @default(autoincrement())
  userId       Int  @unique
  totalGames   Int  @default(0)
  successCount Int  @default(0)

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          Int      @id @default(autoincrement())
  applicantId Int
  approverId  Int
  status      String   @default("PENDING") // PENDING, ACCEPTED（拒否は行削除で表現するためREJECTEDは持たない）
  createdAt   DateTime @default(now())

  applicant   User     @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  approver    User     @relation("Approver", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([applicantId, approverId])
}

/// ブロック関係。方向あり（A→B と B→A は別の行）。
/// ブロックすると該当ペアのFriendshipは全削除されるため、両者が同時に存在することはない。
model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  // 「自分がブロックされているか」の検索が申請のたびに走るため
  @@index([blockedId])
}

model DirectMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  // 会話履歴は OR: [{sender:A,receiver:B}, {sender:B,receiver:A}] で引くため、
  // 両方向のインデックスが要る。1本だと OR の片側がフルスキャンになる
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}
