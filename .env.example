# PostgreSQL
POSTGRES_USER=postgres
# 必須。`openssl rand -base64 32` で生成した値を入れる（未設定だと起動しない）。
# 実値はこのファイルではなく .env にだけ書く（.env は git 管理外）。
# backend/.env の DATABASE_URL にも同じ値を反映すること。
POSTGRES_PASSWORD=
POSTGRES_DB=ft_transcendence

# Backend
# 必須。`openssl rand -base64 48` で生成した値を入れる（未設定だと起動しない）。
# この鍵を知っている人は任意のユーザーになりすませるので、例の値をそのまま使わないこと。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend
# nginx がフロント/バックエンドを同一オリジンで配信するため、
# 通常は空のままでよい（フロントのコードは相対パスで接続する）。
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# nginx が受け付ける公開ポート（外部公開用）
HTTP_PORT=8080
HTTPS_PORT=8443

# 42 OAuth (optional)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=https://localhost/auth/42/callback
