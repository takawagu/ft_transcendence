# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ft_transcendence

# Backend
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# Frontend
# nginx がフロント/バックエンドを同一オリジンで配信するため、
# 通常は空のままでよい（フロントのコードは相対パスで接続する）。
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# nginx が受け付ける公開ポート（外部公開用）
HTTP_PORT=8080
HTTPS_PORT=8443

# 42 OAuth (optional)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=https://localhost/auth/42/callback
